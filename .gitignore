# Build output
/target/

# deadbolt's own run artefacts.
#
# The baseline and the history file are deliberately absent from this list: both are
# meant to be committed. A baseline that is ignored cannot accept anything in CI,
# which is exactly how this repository's own pipeline ended up blocking on findings
# that had already been accepted locally.
/deadbolt-report/
/deadbolt-portfolio/
/.deadbolt-cache/
*.sarif

# Environment files are never committed
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
